# ───────────────────────────────────────────────────────────────────────────
# Reverde · plantilla de variables de entorno
#
# Copia este archivo y complétalo según el ambiente:
#   cp .env.development.example .env.development
#   cp .env.production.example  .env.production   (NUNCA se versiona)
#
# Reglas:
#  - Ningún valor real de producción entra al repositorio.
#  - Los secretos se generan con: openssl rand -base64 48
#  - Las variables VITE_* quedan expuestas en el bundle del navegador:
#    ahí solo van claves públicas.
# ───────────────────────────────────────────────────────────────────────────

# ── Entorno ───────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | production
PORT=4000
# Origen público del frontend (se usa para CORS y para los enlaces de correo).
APP_URL=http://localhost:5173
# Origen público de la API (se usa en las URLs de retorno de la pasarela).
API_URL=http://localhost:4000
# Lista blanca de CORS separada por comas.
CORS_ORIGINS=http://localhost:5173

# ── Base de datos ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reverde:reverde@localhost:5433/reverde_dev?schema=public
# Base de datos usada por `npm run test:api`. Se recrea en cada corrida.
TEST_DATABASE_URL=postgresql://reverde:reverde@localhost:5434/reverde_test?schema=public

# ── Sesiones y criptografía ───────────────────────────────────────────────
# 32 bytes en base64. Cifra datos personales recuperables (teléfono, documento).
ENCRYPTION_KEY=
# Sal del hash de direcciones IP guardadas en auditoría.
IP_HASH_SALT=
SESSION_TTL_HOURS=72
SESSION_COOKIE_NAME=rv_session
CSRF_COOKIE_NAME=rv_csrf
# lax en mismo sitio; none solo si la API vive en otro dominio (exige HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Seguridad ─────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
# Habilita /api/dev/* y las cuentas demo. Debe ser false en producción.
ENABLE_DEMO_ACCOUNTS=true
# Contraseña de las cuentas de demostración (solo desarrollo).
DEMO_PASSWORD=Demo1234
# Token para crear el primer superadministrador vía CLI/endpoint protegido.
SUPERADMIN_BOOTSTRAP_TOKEN=

# ── Correo ────────────────────────────────────────────────────────────────
# log  → imprime el enlace en consola (desarrollo)
# smtp → envía de verdad (producción)
MAIL_TRANSPORT=log
MAIL_FROM="Reverde <no-reply@reverde.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Pasarela de pagos ─────────────────────────────────────────────────────
# mock  → simulador local firmado igual que Wompi (pruebas y desarrollo)
# wompi → Wompi real (sandbox o producción según las llaves)
PAYMENTS_PROVIDER=mock
PAYMENTS_CURRENCY=COP
# Minutos que se mantiene reservado el stock de una orden sin pagar.
PAYMENT_EXPIRY_MINUTES=30
# Interruptor explícito: solo true con llaves de producción y autorización.
PAYMENTS_LIVE_ENABLED=false

# Wompi (sandbox: https://comercios.wompi.co → Desarrolladores)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ── Observabilidad ────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ── Frontend (Vite) ───────────────────────────────────────────────────────
# Vacío = mismo origen vía proxy de Vite. En producción: https://api.reverde.app
VITE_API_URL=
