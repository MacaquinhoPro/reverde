# Reverde · producción. NO copies este archivo al servidor con valores vacíos:
# cárgalos en el gestor de secretos de la plataforma (Vercel/Render/Fly/AWS).
# Ningún valor real debe quedar en el repositorio.
NODE_ENV=production
PORT=4000

# HTTPS obligatorio en los dos orígenes.
APP_URL=https://reverde.app
API_URL=https://api.reverde.app
CORS_ORIGINS=https://reverde.app,https://www.reverde.app

# Base de datos INDEPENDIENTE de la de desarrollo, con SSL.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/reverde_prod?schema=public&sslmode=require
TEST_DATABASE_URL=

# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 32
IP_HASH_SALT=
SESSION_TTL_HOURS=24
# La API vive en api.reverde.app y el frontend en reverde.app: mismo sitio,
# así que `lax` funciona. Si los dominios son distintos usa `none`.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
COOKIE_DOMAIN=.reverde.app

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
# Sin cuentas demo ni endpoints de desarrollo en producción.
ENABLE_DEMO_ACCOUNTS=false
DEMO_PASSWORD=
# Token de un solo uso para crear el primer superadministrador. Bórralo después.
SUPERADMIN_BOOTSTRAP_TOKEN=

MAIL_TRANSPORT=smtp
MAIL_FROM="Reverde <no-reply@reverde.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Pasarela real. PAYMENTS_LIVE_ENABLED exige autorización explícita del equipo:
# con `false` la API rechaza arrancar en modo cobro real.
PAYMENTS_PROVIDER=wompi
PAYMENTS_CURRENCY=COP
PAYMENT_EXPIRY_MINUTES=20
PAYMENTS_LIVE_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://production.wompi.co/v1

LOG_LEVEL=info
LOG_PRETTY=false
VITE_API_URL=https://api.reverde.app
