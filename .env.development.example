# Reverde · desarrollo local. Copia a `.env.development` (ya ignorado por git).
# Los valores de abajo son seguros para local: no sirven en ningún otro lugar.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://reverde:reverde@localhost:5433/reverde_dev?schema=public
TEST_DATABASE_URL=postgresql://reverde:reverde@localhost:5434/reverde_test?schema=public

# Claves de juguete para desarrollo (regenera las tuyas con `openssl rand -base64 32`).
ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
IP_HASH_SALT=dev-ip-salt
SESSION_TTL_HOURS=72
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=1000
ENABLE_DEMO_ACCOUNTS=true
DEMO_PASSWORD=Demo1234
SUPERADMIN_BOOTSTRAP_TOKEN=dev-bootstrap-token

MAIL_TRANSPORT=log
MAIL_FROM="Reverde dev <no-reply@localhost>"

# `mock` permite probar el flujo completo de pago sin salir de la máquina.
# Cambia a `wompi` y pon tus llaves de sandbox para probar contra Wompi.
PAYMENTS_PROVIDER=mock
PAYMENTS_CURRENCY=COP
PAYMENT_EXPIRY_MINUTES=30
PAYMENTS_LIVE_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1

LOG_LEVEL=debug
LOG_PRETTY=true
VITE_API_URL=
